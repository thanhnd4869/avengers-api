NODE_ENV=development
HOST=localhost
PORT=8000
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call the API with
# credentials; empty allows no cross-origin requests at all
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas connection string, used exactly as Atlas provides it
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Database name; kept separate so one cluster can host several environments
MONGODB_DB_NAME=avengers-mongo

# Redis Cloud connection string, from the database's "Connect" panel:
# redis://default:<password>@<host>:<port> (rediss:// when TLS is on).
# Redis holds sessions, emailed links and rate-limit counters.
REDIS_URL=redis://default:<password>@<host>.cloud.redislabs.com:<port>
# Prefix of every key, so environments sharing one Redis Cloud database stay
# apart, e.g. avengers-dev: and avengers:
REDIS_KEY_PREFIX=avengers:

# Signs access tokens (HS256); at least 32 bytes. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Encrypts game keys at rest (AES-256-GCM); exactly 32 random bytes in base64.
# Keep it safe and never change it on its own: keys stocked under one value
# cannot be read with another. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_KEY=

# Checkout: how long keys are held while the shopper pays, and how much
# longer an expired order keeps them so a last-second payment still succeeds.
ORDER_HOLD_MINUTES=10
ORDER_PAYMENT_GRACE_SECONDS=300
ORDER_SWEEP_INTERVAL_SECONDS=30

# VNPay, from the email sent after registering at
# https://sandbox.vnpayment.vn/devreg/ . Payment is offered only when both are
# set. VNPay calls $API_URL/api/v1/payments/vnpay/ipn to confirm payments;
# register that URL with VNPay (it must be reachable from the internet).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Sandbox by default; set both to VNPay's production URLs when going live.
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Cloudinary, from the dashboard's "API Keys" page. The admin can upload
# images and videos only when all three are set; pasting third-party URLs
# keeps working either way. Uploads land in CLOUDINARY_FOLDER, and only files
# in that folder are ever deleted by the API.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=avengers

# Frontend origin used to build the links sent by email
APP_URL=http://localhost:3000

# Public origin of this API. Google and Facebook send the visitor back to
# $API_URL/api/v1/auth/oauth/<provider>/callback, which must be registered as
# a redirect URI in each provider's console.
API_URL=http://localhost:8000

# Sign-in with Google: https://console.cloud.google.com/apis/credentials
# Sign-in with Facebook: https://developers.facebook.com/apps
# A provider is offered only when both of its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Outgoing mail. Leave SMTP_HOST empty in development to log emails instead
# of sending them; production refuses to start without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Avengers <no-reply@example.com>
