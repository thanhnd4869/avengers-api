NODE_ENV=development
HOST=localhost
PORT=8000
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call the API with
# credentials; empty allows no cross-origin requests at all
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas connection string, used exactly as Atlas provides it
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Database name; kept separate so one cluster can host several environments
MONGODB_DB_NAME=avengers-mongo

# Redis Cloud connection string, from the database's "Connect" panel:
# redis://default:<password>@<host>:<port> (rediss:// when TLS is on).
# Redis holds sessions, emailed links and rate-limit counters.
REDIS_URL=redis://default:<password>@<host>.cloud.redislabs.com:<port>
# Prefix of every key, so environments sharing one Redis Cloud database stay
# apart, e.g. avengers-dev: and avengers:
REDIS_KEY_PREFIX=avengers:

# Signs access tokens (HS256); at least 32 bytes. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Frontend origin used to build the links sent by email
APP_URL=http://localhost:3000

# Public origin of this API. Google and Facebook send the visitor back to
# $API_URL/api/v1/auth/oauth/<provider>/callback, which must be registered as
# a redirect URI in each provider's console.
API_URL=http://localhost:8000

# Sign-in with Google: https://console.cloud.google.com/apis/credentials
# Sign-in with Facebook: https://developers.facebook.com/apps
# A provider is offered only when both of its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Outgoing mail. Leave SMTP_HOST empty in development to log emails instead
# of sending them; production refuses to start without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Avengers <no-reply@example.com>
