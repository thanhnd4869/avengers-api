NODE_ENV=development
HOST=localhost
PORT=8000
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call the API with
# credentials; empty allows no cross-origin requests at all
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas connection string, used exactly as Atlas provides it
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Database name; kept separate so one cluster can host several environments
MONGODB_DB_NAME=avengers

# Signs access tokens (HS256); at least 32 bytes. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Frontend origin used to build the links sent by email
APP_URL=http://localhost:3000

# Outgoing mail. Leave SMTP_HOST empty in development to log emails instead
# of sending them; production refuses to start without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Avengers <no-reply@example.com>
